# Copy to .env and fill in. Never commit .env.

MONGO_URI=
PORT=8000
JWT_SECRET=

# Frontend URL(s) allowed by CORS, comma-separated. Defaults to http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- Phone OTP login via Firebase Phone Auth ---
# Only the project id is needed (to verify ID tokens); no service-account key. Defaults to home-seekr-otp
FIREBASE_PROJECT_ID=home-seekr-otp

# --- Email verification codes: set ONE provider key + EMAIL_FROM ---
# Without a key (outside production) emails are printed in the server console instead of being sent.
# Brevo: free 300 emails/day, a single verified sender address works without owning a domain.
BREVO_API_KEY=
# Resend: free 3,000 emails/month (100/day), needs your own verified domain to email other people.
RESEND_API_KEY=
# Sender address verified in Brevo / on your Resend domain, e.g. no-reply@yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=HomeSeekr
